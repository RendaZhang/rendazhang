---
import { BaseLayout } from '../layouts';
import AboutContent from '../components/sections/AboutContent';
import ContactSection from '../components/sections/ContactSection';
import SitePerspective from '../components/sections/SitePerspective';
import SocialIconsEffects from '../components/sections/SocialIconsEffects';
import RequestJourney from '../components/sections/showcase/RequestJourney.astro';
import SocialIcons from '../components/ui/data-display/SocialIcons';
import { ABOUT_CONTENT } from '../content';
import {
  SITE_BASE_URL,
  PAGE_TITLES,
  SITE_DESCRIPTION_EN,
  HOME_PAGE_PATH,
  IMAGE_PATHS,
  RESUME_EN_DOWNLOAD,
  RESUME_ZH_DOWNLOAD,
  STYLE_PATHS,
  buildHomeStructuredDataJson
} from '../constants';
import { getCurrentLang } from '../utils';
import '../styles/components/showcase.css';
import '../styles/components/site-perspective.css';
import '../styles/components/home-notes.css';
import '../styles/components/resume-folds.css';
import '../styles/components/blog.css';

const langDefault = getCurrentLang();
const langKey = langDefault.startsWith('zh') ? 'zh' : 'en';
const titleZh = PAGE_TITLES.ABOUT_ZH;
const titleEn = PAGE_TITLES.ABOUT_EN;
const title = langKey === 'zh' ? titleZh : titleEn;
const resumes = [
  { href: IMAGE_PATHS.RESUME_ZH, filename: RESUME_ZH_DOWNLOAD, label: '中文简历', lang: 'zh-CN' },
  { href: IMAGE_PATHS.RESUME_EN, filename: RESUME_EN_DOWNLOAD, label: 'English CV', lang: 'en' }
] as const;
---

<BaseLayout
  lang={langDefault}
  titleZh={titleZh}
  titleEn={titleEn}
  title={title}
  description={SITE_DESCRIPTION_EN}
  canonical={`${SITE_BASE_URL}${HOME_PAGE_PATH}`}
  structuredDataJson={buildHomeStructuredDataJson()}
  extraStyles={[STYLE_PATHS.ABOUT, STYLE_PATHS.SOCIAL_ICON]}
  bodyClass="c-about-page"
>
  <div id="content">
    <div class="c-home-cover">
      <header class="c-home-signature">
        <h1 id="heroHeading" class="c-home-signature-name">
          <span class="is-lang-zh">{ABOUT_CONTENT.zh.signature.name}</span>
          <span class="is-lang-en">{ABOUT_CONTENT.en.signature.name}</span>
        </h1>
        <p class="c-home-signature-line">
          <span class="is-lang-zh">{ABOUT_CONTENT.zh.signature.line}</span>
          <span class="is-lang-en">{ABOUT_CONTENT.en.signature.line}</span>
        </p>
        <div class="c-home-resumes">
          {
            resumes.map(({ href, filename, label, lang }) => (
              <a href={href} download={filename} lang={lang}>
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M12 3v12m-4-4 4 4 4-4M5 16v4h14v-4" />
                </svg>
                {label}
              </a>
            ))
          }
        </div>
      </header>
      <RequestJourney>
        <SitePerspective slot="perspective" client:load />
      </RequestJourney>
    </div>
    <AboutContent />
    <SocialIcons client:visible />
    <SocialIconsEffects client:load />
    <ContactSection client:visible />
  </div>
</BaseLayout>
