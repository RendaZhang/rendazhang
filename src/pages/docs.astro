---
import { BaseLayout } from '../layouts';
import {
  SITE_BASE_URL,
  DOCS_PAGE_PATH,
  STYLE_PATHS,
  VIEWPORT_NO_ZOOM,
  PAGE_TITLES,
  DOCS_DESCRIPTION,
  DOC_CONTENT,
  buildDocsStructuredDataJson
} from '../constants';
import { DocsEffects } from '../components/sections';
import DocsCaseStudySurface from '../components/sections/DocsCaseStudySurface.astro';
import DocsReading from '../components/sections/DocsReading.astro';
import LocalizedSection from '../components/ui/data-display/LocalizedSection';
import { DOCS_CASE_STUDY_CONTENT, DOCS_READING_SOURCES } from '../content/docsCaseStudyContent';
import { getCurrentLang } from '../utils';
import { renderDocsMarkdown } from '../utils/renderDocsMarkdown';

const langDefault = getCurrentLang();
const langKey = langDefault.startsWith('zh') ? 'zh' : 'en';
const titleZh = PAGE_TITLES.DOCS_ZH;
const titleEn = PAGE_TITLES.DOCS_EN;
const title = langKey === 'zh' ? titleZh : titleEn;
const { zh, en } = DOCS_CASE_STUDY_CONTENT;
const docsHtmlZh = renderDocsMarkdown(DOC_CONTENT.README_ZH, 'zh', {
  'zh-参考架构': 'docs-reference-architecture-zh'
});
const docsHtmlEn = renderDocsMarkdown(DOC_CONTENT.README_EN, 'en', {
  'en-reference-architecture': 'docs-reference-architecture-en'
});
---

<BaseLayout
  lang={langDefault}
  titleZh={titleZh}
  titleEn={titleEn}
  title={title}
  description={DOCS_DESCRIPTION}
  viewport={VIEWPORT_NO_ZOOM}
  canonical={`${SITE_BASE_URL}${DOCS_PAGE_PATH}/`}
  structuredDataJson={buildDocsStructuredDataJson()}
  extraStyles={[
    STYLE_PATHS.GITHUB_CODE_HIGHLIGHT,
    STYLE_PATHS.GITHUB_MARKDOWN_LIGHT,
    STYLE_PATHS.DOCS,
    STYLE_PATHS.MARKDOWN_DARK_MODE
  ]}
  bodyClass="docs-page"
  mainClass="c-main-content c-docs-main"
  og={{
    title: PAGE_TITLES.DOCS_EN,
    description: DOCS_DESCRIPTION,
    url: `${SITE_BASE_URL}${DOCS_PAGE_PATH}/`
  }}
  metaLanguage="en, zh-CN"
>
  <DocsCaseStudySurface />
  <DocsReading />
  <details class="c-docs-full" data-docs-reference>
    <summary>
      <LocalizedSection zhContent={zh.reference.full} enContent={en.reference.full} />
    </summary>
    <ul class="c-docs-reference-links" id="docs-reference" data-docs-destination tabindex="-1">
      <li>
        <a href={DOCS_READING_SOURCES.delivery}>
          <LocalizedSection zhContent={zh.reference.delivery} enContent={en.reference.delivery} />
        </a>
      </li>
      <li>
        <a href={DOCS_READING_SOURCES.maintenance}>
          <LocalizedSection
            zhContent={zh.reference.maintenance}
            enContent={en.reference.maintenance}
          />
        </a>
      </li>
      <li>
        <a class="c-docs-return" href="#docs-route-title" data-docs-return>
          <LocalizedSection
            zhContent={zh.reference.backToDiagram}
            enContent={en.reference.backToDiagram}
          />
        </a>
      </li>
    </ul>
    <div id="content-zh" lang="zh-CN" class="is-lang-zh c-markdown-body" set:html={docsHtmlZh} />
    <div id="content-en" lang="en" class="is-lang-en c-markdown-body" set:html={docsHtmlEn} />
  </details>
  <Fragment slot="bodyEnd">
    <DocsEffects client:load />
  </Fragment>
</BaseLayout>
