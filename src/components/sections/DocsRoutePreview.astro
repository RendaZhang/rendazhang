---
import { DOCS_DEMO_FRAGMENTS } from '../../content/docsCaseStudyContent';
import LocalizedSection from '../ui/data-display/LocalizedSection';

interface Props {
  station: 'browser' | 'nginx' | 'static' | 'model' | 'flask';
  route: 'page' | 'chat';
}

const { station, route } = Astro.props;
const languages = ['zh', 'en'] as const;
const showsJsonLines = station === 'flask' || station === 'nginx';
const sample = {
  zh: {
    title: '架构笔记',
    text: '从这里查看网页与聊天请求的路径。',
    detail: '展开一行',
    opened: '两条路径都经过 Nginx。'
  },
  en: {
    title: 'Architecture notes',
    text: 'Follow the paths of page requests and chat messages.',
    detail: 'Open a note',
    opened: 'Both routes pass through Nginx.'
  }
};
---

<div class="c-docs-demo" data-docs-demo={`${station}-${route}`}>
  <div class="c-docs-demo-label"><LocalizedSection zhContent="模拟" enContent="Simulation" /></div>
  {
    route === 'page' && station === 'static' && (
      <>
        <code>docs/index.html</code>
        {languages.map((language) => (
          <pre class={`is-lang-${language}`}>
            <code>{`<h1>${sample[language].title}</h1>\n<p>${sample[language].text}</p>`}</code>
          </pre>
        ))}
      </>
    )
  }
  {
    route === 'page' && station === 'nginx' && (
      <div class="c-docs-demo-transfer">
        <code>GET /docs/</code>
        <div>
          <span aria-hidden="true">↓</span> <code>docs/index.html</code>
        </div>
        <code>200 · text/html</code>
      </div>
    )
  }
  {
    route === 'page' && station === 'browser' && (
      <div class="c-docs-demo-window">
        <strong>
          <LocalizedSection zhContent={sample.zh.title} enContent={sample.en.title} />
        </strong>
        <div>
          <LocalizedSection zhContent={sample.zh.text} enContent={sample.en.text} />
        </div>
        <div class="c-docs-demo-states">
          <span>
            <LocalizedSection zhContent="正文可读" enContent="Text is readable" />
          </span>
          <span aria-hidden="true">→</span>
          <span class="c-docs-demo-ready">
            <LocalizedSection zhContent="脚本功能就绪" enContent="Scripted controls are ready" />
          </span>
        </div>
        <details class="c-docs-demo-control">
          <summary>
            <LocalizedSection zhContent={sample.zh.detail} enContent={sample.en.detail} />
          </summary>
          <div>
            <LocalizedSection zhContent={sample.zh.opened} enContent={sample.en.opened} />
          </div>
        </details>
      </div>
    )
  }
  {
    route === 'chat' && (
      <>
        {station === 'nginx' && (
          <>
            <div class="c-docs-demo-transfer">
              <div class="c-docs-demo-direction">
                <LocalizedSection
                  zhContent="请求 · 浏览器 → Flask"
                  enContent="Request · Browser → Flask"
                />
              </div>
              <code>POST /cloudchat/deepseek_chat</code>
              <div>
                <span aria-hidden="true">↓</span> <code>POST /deepseek_chat</code>
              </div>
            </div>
            <div class="c-docs-demo-response">
              <div class="c-docs-demo-direction">
                <LocalizedSection
                  zhContent="响应 · Flask → 浏览器"
                  enContent="Response · Flask → browser"
                />
              </div>
              <code class="c-docs-demo-setting">proxy_buffering off</code>
            </div>
          </>
        )}
        <div class:list={['c-docs-demo-stream', { 'c-docs-demo-bubble': station === 'browser' }]}>
          {languages.map((language) => (
            <div class={`is-lang-${language}`}>
              {DOCS_DEMO_FRAGMENTS[language].map((fragment) => (
                <span class="c-docs-fragment">
                  {showsJsonLines ? <code>{JSON.stringify({ text: fragment })}</code> : fragment}
                </span>
              ))}
            </div>
          ))}
        </div>
      </>
    )
  }
</div>
